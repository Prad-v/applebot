# Copy to .env to override defaults used by docker-compose.yml. Never commit secrets.

# Swift toolchain image used for the Linux test runner.
SWIFT_IMAGE=swift:6.2

# Host port for the static user-guide site (docker compose up site).
SITE_PORT=8088

# Gmail connector: OAuth client ID of type "iOS" from Google Cloud Console, for example
# 1234567890-abcdefg.apps.googleusercontent.com. It is public (no secret). Leave empty to disable Gmail.
# Picked up by `make project`, which writes it to the git-ignored ios/Local.xcconfig.
GOOGLE_CLIENT_ID=

# Web search connector: Brave Search API key (free tier: https://brave.com/search/api/). Leave empty to disable
# Web search. Weather and Stocks need no key. The key is compiled into your own build, so use it for personal
# builds only. Picked up by `make project`, which writes it to the git-ignored ios/Local.xcconfig.
BRAVE_API_KEY=
